{
  "name": "dsh-qq-rooms",
  "version": "0.1.0",
  "description": "QQ 与 DSH 双向互通：聊天即房间，不用手动绑定会话；主人一个号管审批与群接入。",
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "onebot",
    "qq"
  ],
  "author": "Yukolike",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yukolike/dsh-qq-rooms.git"
  },
  "homepage": "https://github.com/Yukolike/dsh-qq-rooms",
  "bugs": {
    "url": "https://github.com/Yukolike/dsh-qq-rooms/issues"
  },
  "license": "MIT"
}
